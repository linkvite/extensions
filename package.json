{
	"name": "linkvite-extension",
	"displayName": "Linkvite",
	"version": "1.0.0",
	"private": true,
	"description": "The easiest way to save and organize your bookmarks.",
	"author": "Linkvite <contact@linkvite.io>",
	"homepage_url": "https://linkvite.io",
	"type": "module",
	"scripts": {
		"dev": "node scripts/ensure-sdk.mjs && wxt",
		"dev:firefox": "node scripts/ensure-sdk.mjs && wxt -b firefox",
		"build": "node scripts/ensure-sdk.mjs && wxt build",
		"build:firefox": "node scripts/ensure-sdk.mjs && wxt build -b firefox",
		"build:safari": "node scripts/ensure-sdk.mjs && wxt build -b safari",
		"build:staging": "node scripts/ensure-sdk.mjs && WXT_API_ENV=staging wxt build",
		"zip": "node scripts/ensure-sdk.mjs && wxt zip",
		"zip:firefox": "node scripts/ensure-sdk.mjs && wxt zip -b firefox",
		"typecheck": "node scripts/ensure-sdk.mjs && tsc --noEmit",
		"lint": "biome check .",
		"lint:write": "biome check . --write",
		"postinstall": "wxt prepare",
		"sdk:build": "pnpm -C ../js install --frozen-lockfile && pnpm -C ../js build"
	},
	"dependencies": {
		"@linkvite/js": "^4.0.0",
		"centrifuge": "^5.3.4",
		"lucide-react": "^0.468.0",
		"qrcode.react": "^4.2.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"sonner": "^2.0.8"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@tailwindcss/vite": "^4.3.3",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@wxt-dev/module-react": "^1.1.3",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.0",
		"wxt": "^0.20.6"
	},
	"packageManager": "pnpm@10.30.3",
	"pnpm": {
		"overrides": {
			"@linkvite/js": "link:../js"
		}
	}
}
